# Copy locally to .env, set in your hosting provider secret settings. Never commit .env.
AURS_ENV=development
AURS_ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_20_PLUS_CHAR_PASSWORD
AURS_SECRET_KEY=REPLACE_WITH_RANDOM_64_PLUS_CHAR_HEX_SECRET
# HTTPS staging/prod: 1. Production startup will refuse 0.
AURS_COOKIE_SECURE=0
# On production HTTPS: https://your-owned-domain.example (no path)
AURS_PUBLIC_ORIGIN=
# Production must point to an ABSOLUTE mounted/persistent directory.
AURS_DATA_DIR=./data
# INACTIVE, NOT CONNECTED. All following are optional and server-side ONLY.
AURS_META_AD_ACCOUNT_ID=
AURS_META_PIXEL_ID=
AURS_META_CAPI_TOKEN=
AURS_WA_PHONE_NUMBER_ID=
AURS_WA_BUSINESS_ACCOUNT_ID=
AURS_WA_ACCESS_TOKEN=
AURS_WA_VERIFY_TOKEN=
AURS_WA_APP_SECRET=
